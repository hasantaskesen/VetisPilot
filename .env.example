# Copy this file to .env and set your own values. Never commit .env.
POSTGRES_DB=vetispilot
POSTGRES_USER=vetispilot
POSTGRES_PASSWORD=change-me

# Key that signs the login tokens (JWT). At least 32 random characters, e.g. from a password generator.
JWT_SECRET=change-me-to-a-long-random-value-of-32-chars-or-more
